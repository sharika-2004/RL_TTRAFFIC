<routes>
    <vType id="car" accel="1.0" decel="4.5" length="5" maxSpeed="25"/>

    <!-- Routes go THROUGH intersection -->
    <route id="north_route" edges="north_in south_out"/>
    <route id="south_route" edges="south_in north_out"/>
    <route id="east_route" edges="east_in west_out"/>
    <route id="west_route" edges="west_in east_out"/>

    <!-- Continuous flow -->
    <flow id="north_flow" type="car" route="north_route" begin="0" end="100" number="50"/>
    <flow id="south_flow" type="car" route="south_route" begin="0" end="100" number="50"/>
    <flow id="east_flow" type="car" route="east_route" begin="0" end="100" number="50"/>
    <flow id="west_flow" type="car" route="west_route" begin="0" end="100" number="50"/>
</routes>